# ── PostgreSQL Database ─────────────────────────────────────────────────────
# Note: If password contains special characters like '@', URL-encode as '%40'
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password_here@localhost:5432/ecom

# ── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# ── LLM Provider Configuration ──────────────────────────────────────────────
# Supported options: groq | ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ── Intent-Safety Classifier / Guardrails ──────────────────────────────────
GUARDRAIL_ENABLED=true
GUARDRAIL_INTENT_MODEL=openai/gpt-oss-20b
GUARDRAIL_PROMPT_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
GUARDRAIL_PROMPT_GUARD_THRESHOLD=0.85
GUARDRAIL_TIMEOUT=5.0

# Alternative: Local Ollama
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# ── Embedding Model ─────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Langfuse Observability (Optional) ───────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
# LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_HOST=https://cloud.langfuse.com
